
{
  "version": 8,
  "configurePresets": [
    {
      "name": "emulator",
      "displayName": "SDL2 Emulator (WSL)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PI_CLOCK_UI_EMULATOR": "ON"
      }
    },
    {
      "name": "hardware",
      "displayName": "Raspberry Pi (SSD1306)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PI_CLOCK_UI_EMULATOR": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "emulator",
      "configurePreset": "emulator",
      "jobs": 4
    },
    {
      "name": "hardware",
      "configurePreset": "hardware",
      "jobs": 2
    }
  ]
}
